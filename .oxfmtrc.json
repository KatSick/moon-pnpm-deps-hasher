{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".protolock",
    ".sc/**",
    ".moon/cache/**",
    "**/dist/**",
    "**/coverage/**"
  ]
}
